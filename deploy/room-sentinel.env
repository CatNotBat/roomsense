# Room Sentinel environment config for RPi deployment
# Copy to /etc/room-sentinel.env and adjust as needed

SENTINEL_MQTT_HOST=localhost
SENTINEL_MQTT_PORT=1883
SENTINEL_FLASK_HOST=0.0.0.0
SENTINEL_FLASK_PORT=8080

# Uncomment and set if using MQTT auth
# SENTINEL_MQTT_USER=sentinel
# SENTINEL_MQTT_PASS=changeme
