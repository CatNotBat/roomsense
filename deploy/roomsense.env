# RoomSense environment config for RPi deployment
# Copy to /etc/roomsense.env and adjust as needed

ROOMSENSE_MQTT_HOST=localhost
ROOMSENSE_MQTT_PORT=1883
ROOMSENSE_FLASK_HOST=0.0.0.0
ROOMSENSE_FLASK_PORT=8080

# Uncomment and set if using MQTT auth
# ROOMSENSE_MQTT_USER=sentinel
# ROOMSENSE_MQTT_PASS=changeme
