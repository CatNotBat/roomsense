[Unit]
Description=RoomSense — BLE + mmWave presence detection
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/roomsense
ExecStart=/opt/roomsense/.venv/bin/python src/live_ble.py
Restart=on-failure
RestartSec=5

# Environment (override in /etc/roomsense.env if needed)
EnvironmentFile=-/etc/roomsense.env

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/roomsense/calibration /opt/roomsense/models

[Install]
WantedBy=multi-user.target
